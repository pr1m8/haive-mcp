# haive-mcp Environment Variables
# Copy this file to .env and fill in your values.

# === MCP Agent Settings ===
# MCP_AUTO_DISCOVER=true          # Auto-discover MCP servers for tasks
# MCP_REQUIRE_APPROVAL=true       # Require human approval before installing servers
# MCP_HEALTH_CHECK_INTERVAL=30    # Health check interval in seconds

# === API Keys (for MCP servers that need them) ===
# GITHUB_TOKEN=                   # GitHub MCP server
# BRAVE_API_KEY=                  # Brave Search MCP server
# OPENAI_API_KEY=                 # OpenAI (for LLM-powered agents)
# AZURE_OPENAI_API_KEY=           # Azure OpenAI
# AZURE_OPENAI_ENDPOINT=          # Azure OpenAI endpoint

# === Database (for database MCP servers) ===
# DATABASE_URL=postgresql://user:pass@localhost:5432/mydb
